#version 450

// Trivial end-to-end compute shader. Tests dispatch it and check the values,
// which proves glslc -> SPIR-V -> descriptor set -> dispatch -> readback works.

layout(local_size_x = 64) in;

layout(binding = 0) buffer Data {
    uint values[];
} data;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.values.length()) {
        return;
    }
    data.values[i] = i * 3u + 7u;
}
