# Embeds a binary file (the panel font) in a target as a C++ byte array, so the
# title needs no file next to it and no system font.
#
#   include(<repo>/cmake/embed_file.cmake)
#   splat_embed_file(<target> <input file> <symbol>)
#
# adds a generated source that defines, in namespace splat,
#   extern const unsigned char <symbol>[];
#   extern const std::size_t <symbol>_size;
# Run in script mode (cmake -DINPUT= -DOUTPUT= -DSYMBOL= -P embed_file.cmake) it
# writes that source; the build re-runs it when the input changes.
#
# SPDX-License-Identifier: GPL-3.0-or-later

if(CMAKE_SCRIPT_MODE_FILE)
    file(READ "${INPUT}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(WRITE "${OUTPUT}"
        "// Generated by cmake/embed_file.cmake from ${INPUT}; do not edit.\n"
        "#include <cstddef>\n"
        "namespace splat {\n"
        "extern const unsigned char ${SYMBOL}[];\n"
        "extern const std::size_t ${SYMBOL}_size;\n"
        "alignas(4) const unsigned char ${SYMBOL}[] = {${bytes}};\n"
        "const std::size_t ${SYMBOL}_size = ${size};\n"
        "}  // namespace splat\n")
    return()
endif()

set(SPLAT_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_FILE}" CACHE INTERNAL "cmake/embed_file.cmake")

function(splat_embed_file target input symbol)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/embed/${symbol}.cpp")
    add_custom_command(
        OUTPUT "${output}"
        COMMAND "${CMAKE_COMMAND}" "-DINPUT=${input}" "-DOUTPUT=${output}" "-DSYMBOL=${symbol}"
                -P "${SPLAT_EMBED_SCRIPT}"
        DEPENDS "${input}" "${SPLAT_EMBED_SCRIPT}"
        COMMENT "embed ${symbol}"
        VERBATIM)
    target_sources(${target} PRIVATE "${output}")
endfunction()
