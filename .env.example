# Copy to .env.local and fill in your console's address. .env.local is
# gitignored; these values are never committed.
#
#   cp .env.example .env.local
#
# The scripts in platform/ps5/scripts/ read every PS5_* key from .env.local
# (environment variables take precedence).

# Console LAN address (required for deploy, logs and the title scripts).
PS5_HOST=

# prospero = upload and launch through ProsperoMgr (default)
# raw      = stream the ELF to elfldr
PS5_DEPLOY_METHOD=prospero

# ProsperoMgr dashboard/API.
PS5_PROSPERO_PORT=7070

# elfldr, for PS5_DEPLOY_METHOD=raw.
PS5_PORT=9021

# Console log stream (klogsrv).
PS5_KLOG_PORT=3232
PS5_KLOGSRV_PORT=3232
PS5_KLOGSRV_PAYLOAD=klogsrv.elf

# ShadowMountPlus API, used by title.sh install to rescan /data/homebrew.
PS5_SHADOWMOUNT_PORT=10101

# title.sh waits (seconds).
PS5_TITLE_WAIT=90
PS5_TITLE_QUIT_WAIT=20
